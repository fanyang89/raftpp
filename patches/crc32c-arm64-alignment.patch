+// Helper functions to load data without alignment requirements.
+// memcpy is optimized by the compiler into efficient load instructions.
+static inline uint64_t LoadUint64(const uint8_t* p) {
+  uint64_t result;
+  std::memcpy(&result, p, sizeof(result));
+  return result;
+}
+
+static inline uint32_t LoadUint32(const uint8_t* p) {
+  uint32_t result;
+  std::memcpy(&result, p, sizeof(result));
+  return result;
+}
